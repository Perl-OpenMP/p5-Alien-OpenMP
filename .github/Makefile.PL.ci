# CI-only Makefile.PL for testing the Dist::Zilla author tree without
# requiring Dist::Zilla or its author-plugin stack in every compiler job.
#
# The release tarball's Makefile.PL remains generated by Dist::Zilla.
use strict;
use warnings;

use ExtUtils::MakeMaker;
use Alien::Build::MM;

my %WriteMakefileArgs = (
  NAME          => 'Alien::OpenMP',
  DISTNAME      => 'Alien-OpenMP',
  VERSION_FROM  => 'lib/Alien/OpenMP.pm',
  ABSTRACT_FROM => 'lib/Alien/OpenMP.pm',
  AUTHOR        => 'oodler <oodler@cpan.org>',
  LICENSE       => 'perl_5',

  CONFIGURE_REQUIRES => {
    'Alien::Build::MM'    => 0,
    'ExtUtils::MakeMaker' => 0,
  },
  BUILD_REQUIRES => {
    'Alien::Build::MM' => 0,
  },
  PREREQ_PM => {
    'Alien::Base' => 0,
    'Inline::C'   => '0.62',
  },
  TEST_REQUIRES => {
    'Capture::Tiny' => 0,
    'Test::Alien'   => 0,
    'Test::Needs'   => 0,
  },
);

my $abmm = Alien::Build::MM->new;
%WriteMakefileArgs = $abmm->mm_args(%WriteMakefileArgs);

WriteMakefile(%WriteMakefileArgs);

{
  package MY;

  sub postamble {
    $abmm->mm_postamble(@_);
  }

  sub install {
    $abmm->can('mm_install')
      ? $abmm->mm_install(@_)
      : shift->SUPER::install(@_);
  }
}
